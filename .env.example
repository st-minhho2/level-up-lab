# Copy to .env with scripts/setup-env.sh. Local throwaway values only; production configuration never lives in
# this repository or in the dev container. Keys below are rewritten per worktree by scripts/worktree.sh.
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/level_up_lab?schema=public
PORT=3000
NEXT_DIST_DIR=.next
UPLOAD_DIR=./storage/uploads
CACHE_PREFIX=main
NODE_ENV=development
