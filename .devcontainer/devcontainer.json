{
  "name": "level-up-lab",
  // Same base image string as .github/workflows/ci.yml (env.CI_IMAGE). Change both or neither.
  "dockerComposeFile": ["../docker-compose.yml", "docker-compose.yml"],
  "service": "app",
  // The repo ROOT is mounted (see docker-compose.yml). Never open a single worktree folder as the workspace:
  // a worktree's .git is a file pointing at ../../.git, which would be outside the mount.
  "workspaceFolder": "/workspace",
  "shutdownAction": "stopCompose",
  "remoteUser": "node",
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {}
  },
  // SSH: keys stay on the host. VS Code / the devcontainer CLI forward the host ssh-agent socket automatically
  // when SSH_AUTH_SOCK is set on the host; nothing under ~/.ssh is mounted or copied.
  "postCreateCommand": "corepack enable && corepack prepare pnpm@10.24.0 --activate && scripts/setup-env.sh && pnpm exec playwright install --with-deps chromium",
  "forwardPorts": [3000, 5432],
  "portsAttributes": { "3000": { "label": "next dev" }, "5432": { "label": "postgres" } },
  "customizations": {
    "vscode": {
      "extensions": [
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "Prisma.prisma",
        "vitest.explorer",
        "ms-playwright.playwright"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "typescript.tsdk": "node_modules/typescript/lib"
      }
    }
  }
}
