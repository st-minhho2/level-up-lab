// Models arrive with their feature spec (specs/FEAT-xxx.md) and their migration in the same commit.
// Conventions: PascalCase singular model, camelCase fields, @@map to snake_case plural table, cuid ids,
// createdAt/updatedAt on every table. See .claude/rules/prisma.md.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// §3 Todo (card B1.1)
model Todo {
  id        String    @id @default(cuid())
  title     String    @db.VarChar(200)
  completed Boolean   @default(false)
  // §15: a calendar day, no time of day; null = no due date. No index: nothing orders or filters by it (§1).
  dueDate   DateTime? @db.Date
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([createdAt])
  @@map("todos")
}
